# music-import configuration (systemd user unit EnvironmentFile).
# Copy to ~/.config/music-import/music-import.env and adjust as needed.
# Everything here is optional; the defaults in src/musicimport/config.py apply.

# Where the web UI listens. Use 127.0.0.1 for direct access, or the docker
# bridge gateway (e.g. 172.17.0.1) if a containerized reverse proxy must reach it.
MUSIC_IMPORT_HOST=127.0.0.1
MUSIC_IMPORT_PORT=8318

# Root of your media tree. Release sources default to
#   <media>/downloads/torrents/complete/lidarr
#   <media>/downloads/soulseek/complete
# and the beets library to <media>/music.
MUSIC_IMPORT_MEDIA=/media

# Override individual paths only if your layout differs:
# MUSIC_IMPORT_LIDARR=/path/to/lidarr/complete
# MUSIC_IMPORT_SOULSEEK=/path/to/soulseek/complete
# MUSIC_IMPORT_MUSIC=/path/to/music
# MUSIC_IMPORT_STAGING=/path/to/staging

# External tools are resolved from PATH. Set these if they are not on PATH:
# MUSIC_IMPORT_FLACCHECK=/path/to/flaccheck
# MUSIC_IMPORT_BEET=/path/to/beet
